<!--pages/drawing-video/drawing-video.wxml-->
<view class="dv-container">
  <!-- 生成中：过渡视频 -->
  <view class="dv-canvas-section" wx:if="{{generating}}">
    <view class="dv-canvas-wrapper">
      <video
        id="transitionVideo"
        class="dv-transition-video"
        src="{{transitionVideoUrl}}"
        autoplay
        loop
        muted
        show-center-play-btn="{{false}}"
        show-play-btn="{{false}}"
        controls="{{false}}"
        enable-play-gesture="{{false}}"
        show-fullscreen-btn="{{false}}"
        object-fit="contain"
        binderror="onVideoError"
        bindloadedmetadata="onVideoLoaded">
      </video>
      <cover-view class="dv-video-overlay" wx:if="{{generating}}"></cover-view>
    </view>
    <view class="dv-generating-info">
      <text class="dv-generating-text">{{tGenerating}}</text>
      <text class="dv-generating-sub">{{tGeneratingSub}}</text>
    </view>
  </view>

  <!-- 完成后：视频 / 原图 / 素描 -->
  <view class="dv-result-section" wx:if="{{videoReady && !generating}}">
    <!-- 视频（第一行，全宽） -->
    <view class="dv-video-row">
      <view class="dv-comparison-item">
        <text class="dv-label">{{tVideoTitle}}</text>
        <view class="dv-video-wrapper" bindtap="openFullscreenVideo">
          <video
            class="dv-video"
            src="{{videoUrl}}"
            autoplay
            loop
            show-center-play-btn
            object-fit="contain"
            poster="{{sketchUrl}}">
          </video>
          <view class="dv-video-tap-hint">
            <text>{{tTapToEnlarge}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 原图 + 素描（第二行，并排） -->
    <view class="dv-images-row">
      <view class="dv-comparison-item" wx:if="{{showResult && (resultUrlLocal || resultUrl)}}">
        <text class="dv-label">{{tResultTitle}}</text>
        <view class="dv-result-wrapper" bindtap="openFullscreenResult">
          <image class="dv-result-image" src="{{resultUrlLocal || resultUrl}}" mode="aspectFit" show-menu-by-longpress binderror="onImageError"></image>
          <view class="dv-brush-reveal {{resultRevealed ? 'revealed' : ''}}">
            <view class="dv-brush-stripe" style="animation-delay: 0s"></view>
            <view class="dv-brush-stripe" style="animation-delay: 0.2s"></view>
            <view class="dv-brush-stripe" style="animation-delay: 0.4s"></view>
            <view class="dv-brush-stripe" style="animation-delay: 0.6s"></view>
            <view class="dv-brush-stripe" style="animation-delay: 0.8s"></view>
          </view>
          <view class="dv-result-tap-hint">
            <text>{{tTapToEnlarge}}</text>
          </view>
        </view>
      </view>
      <view class="dv-comparison-item" wx:if="{{showSketch && (sketchUrlLocal || sketchUrl)}}">
        <text class="dv-label">{{tSketchTitle}}</text>
        <view class="dv-sketch-wrapper" bindtap="openFullscreenSketch">
          <image class="dv-sketch-image" src="{{sketchUrlLocal || sketchUrl}}" mode="aspectFit" show-menu-by-longpress binderror="onImageError"></image>
          <view class="dv-brush-reveal {{sketchRevealed ? 'revealed' : ''}}">
            <view class="dv-brush-stripe" style="animation-delay: 0s"></view>
            <view class="dv-brush-stripe" style="animation-delay: 0.2s"></view>
            <view class="dv-brush-stripe" style="animation-delay: 0.4s"></view>
            <view class="dv-brush-stripe" style="animation-delay: 0.6s"></view>
            <view class="dv-brush-stripe" style="animation-delay: 0.8s"></view>
          </view>
          <view class="dv-sketch-tap-hint">
            <text>{{tTapToEnlarge}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 消耗信息 -->
    <view class="dv-cost-info">
      <text class="dv-cost-text">{{tCostPrefix}}：{{totalCost}}{{tHairs}}</text>
      <text class="dv-remaining">{{tRemaining}}：{{remainingHairs}}{{tHairs}}</text>
    </view>

    <!-- 风格选择 -->
    <view class="dv-style-selector">
      <text class="dv-style-label">{{tStyleLabel}}</text>
      <view class="dv-style-options">
        <view class="dv-style-option {{style === 'pencil' ? 'active' : ''}}" bindtap="selectStyle" data-style="pencil">
          <text>{{tStylePencil}}</text>
        </view>
        <view class="dv-style-option {{style === 'vivid' ? 'active' : ''}}" bindtap="selectStyle" data-style="vivid">
          <text>{{tStyleVivid}}</text>
        </view>
        <view class="dv-style-option {{style === 'ink' ? 'active' : ''}}" bindtap="selectStyle" data-style="ink">
          <text>{{tStyleInk}}</text>
        </view>
        <view class="dv-style-option {{style === 'anime' ? 'active' : ''}}" bindtap="selectStyle" data-style="anime">
          <text>{{tStyleAnime}}</text>
        </view>
      </view>
      <button class="dv-btn regenerate-btn" bindtap="regenerateVideo">
        <text>{{tRegenerate}}</text>
      </button>
    </view>

    <!-- 操作按钮 -->
    <view class="dv-actions">
      <view class="dv-actions-row">
        <button class="dv-btn secondary" bindtap="saveVideoToAlbum">
          <text>{{tSaveVideo}}</text>
        </button>
        <button class="dv-btn secondary" bindtap="saveResultToAlbum" wx:if="{{resultUrl}}">
          <text>{{tSaveResult}}</text>
        </button>
      </view>
      <view class="dv-actions-row">
        <button class="dv-btn secondary" bindtap="saveSketchToAlbum">
          <text>{{tSaveSketch}}</text>
        </button>
        <button class="dv-btn primary" bindtap="goHome">
          <text>{{tGoHome}}</text>
        </button>
      </view>
    </view>
  </view>

  <!-- 错误状态 -->
  <view class="dv-error-section" wx:if="{{error && !generating}}">
    <text class="dv-error-text">{{error}}</text>
    <button class="dv-btn primary" bindtap="goHome">{{tGoHome}}</button>
  </view>

  <!-- 全屏视频预览 -->
  <view class="dv-fullscreen-overlay" wx:if="{{videoFullscreen}}" bindtap="closeFullscreenVideo">
    <video
      class="dv-fullscreen-video"
      src="{{videoUrl}}"
      autoplay
      loop
      show-center-play-btn
      object-fit="contain"
      controls>
    </video>
    <view class="dv-fullscreen-close">
      <text class="dv-fullscreen-close-icon">×</text>
    </view>
  </view>

  <!-- 全屏图片预览 -->
  <view class="dv-fullscreen-overlay" wx:if="{{sketchFullscreen}}" bindtap="closeFullscreenSketch">
    <image class="dv-fullscreen-image" src="{{sketchUrlLocal || sketchUrl}}" mode="aspectFit"></image>
    <view class="dv-fullscreen-close">
      <text class="dv-fullscreen-close-icon">×</text>
    </view>
  </view>

  <!-- 全屏原图预览 -->
  <view class="dv-fullscreen-overlay" wx:if="{{resultFullscreen}}" bindtap="closeFullscreenResult">
    <image class="dv-fullscreen-image" src="{{resultUrlLocal || resultUrl}}" mode="aspectFit"></image>
    <view class="dv-fullscreen-close">
      <text class="dv-fullscreen-close-icon">×</text>
    </view>
  </view>
</view>
